# Copia este archivo como .env y rellena SOLO la clave del proveedor que uses.
PROVIDER=gemini

# Gemini (gratis con límites): https://aistudio.google.com/
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Modelo más potente solo para los resúmenes (opcional, pocas llamadas):
# GEMINI_SUMMARY_MODEL=gemini-2.5-pro

# Precisión: dile qué estás haciendo
# CONTEXT=League of Legends, juego Jinx de ADC en bot lane

# Enviar resultados a otro sistema (opcional)
# WEBHOOK_URL=https://tu-servidor.com/hook
# WEBHOOK_SECRET=una-frase-larga-y-secreta
# WEBHOOK_MIN_IMPORTANCE=1
# WEBHOOK_SUMMARY_EVERY=5
# API_TOKEN=otra-frase-larga-y-secreta

# Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
