# Clave de la API de Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Opcionales
# PANTALLA_MODEL=claude-opus-5-5     # p. ej. claude-sonnet-5-5 para ahorrar coste
# PANTALLA_EFFORT=low                # low | medium | high | xhigh | max
# PANTALLA_FALLBACKS=1               # 0 desactiva el reintento automático en otro modelo
# PORT=3000
# HOST=127.0.0.1                   # no lo cambies salvo que sepas lo que haces
